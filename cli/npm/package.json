{
  "name": "@orchestrai/cli",
  "version": "0.0.0",
  "description": "The OrchestrAI CLI (orchestrai / ork): sync your team's AI rules, skills and MCP servers, install from the library, run workflows and ask the team agent.",
  "license": "MIT",
  "homepage": "https://orchestrai.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrchestrAIio/orchestrai.git",
    "directory": "cli/npm"
  },
  "bin": {
    "orchestrai": "bin/orchestrai.js",
    "ork": "bin/orchestrai.js"
  },
  "files": [
    "bin/",
    "lib/",
    "install.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test test/binary.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "publishConfig": {
    "access": "public"
  }
}
